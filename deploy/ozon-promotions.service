[Unit]
Description=Ozon promotions opt-in schedule dispatcher
After=network-online.target

[Service]
Type=oneshot
User=ozon-monitor
Group=ozon-monitor
WorkingDirectory=/opt/ozon-push-monitor
ExecStart=/usr/bin/python3.11 /opt/ozon-push-monitor/promotions.py --tick
UMask=0077
Nice=10
MemoryMax=192M
CPUQuota=25%
TimeoutStartSec=7200
